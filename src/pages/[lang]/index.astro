---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, t, localePath, locales, defaultLocale } from '../../i18n/index';

export function getStaticPaths() {
  return locales.filter(l => l !== defaultLocale).map(lang => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
---

<Layout title={i.home.title}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-label">{i.home.heroLabel}</p>
      <h1 class="hero-title">
        {i.home.heroTitle1}<br />
        <span class="hero-accent">{i.home.heroTitle2}</span>
      </h1>
      <p class="hero-desc">{i.home.heroDesc}</p>
      <div class="hero-actions">
        <a href="#products" class="btn btn-primary">{i.home.heroBtn1}</a>
        <a href={localePath(lang, '/contact')} class="btn btn-outline">{i.home.heroBtn2}</a>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section" id="products" style="padding-top: 5rem; padding-bottom: 3rem;">
    <p class="section-label">{i.home.productsLabel}</p>
    <h2 class="section-title">{i.home.productsTitle}</h2>
    <p class="section-desc">{i.home.productsDesc}</p>

    <div class="grid-4" style="margin-top: 2.5rem;">
      <a class="card card-link" href="https://rent.wf" target="_blank" rel="noopener">
        <div class="card-icon">&#127958;&#65039;</div>
        <h3 class="card-title">{i.home.rentTitle}</h3>
        <p class="card-for">{i.home.rentFor}</p>
        <p class="card-value">{i.home.rentValue}</p>
      </a>
      <a class="card card-link" href="https://taxi.rent.wf" target="_blank" rel="noopener">
        <div class="card-icon">&#128661;</div>
        <h3 class="card-title">{i.home.taxiTitle}</h3>
        <p class="card-for">{i.home.taxiFor}</p>
        <p class="card-value">{i.home.taxiValue}</p>
      </a>
      <a class="card card-link" href="https://chat.fodylabs.com" target="_blank" rel="noopener">
        <div class="card-icon">&#128172;</div>
        <h3 class="card-title">{i.home.chatTitle}</h3>
        <p class="card-for">{i.home.chatFor}</p>
        <p class="card-value">{i.home.chatValue}</p>
      </a>
      <a class="card card-link" href="https://radioller.com" target="_blank" rel="noopener">
        <div class="card-icon">&#128251;</div>
        <h3 class="card-title">{i.home.radTitle} <span class="card-badge">{i.home.radBadge}</span></h3>
        <p class="card-for">{i.home.radFor}</p>
        <p class="card-value">{i.home.radValue}</p>
      </a>
    </div>
  </section>

  <!-- Trust -->
  <section class="stats-section">
    <div class="section">
      <h2 class="section-title" style="text-align: center;">{i.home.trustTitle}</h2>
      <p class="section-desc" style="text-align: center; margin: 0 auto 2.5rem;">{i.home.trustDesc}</p>
      <div class="stats-grid">
        <div class="stat">
          <span class="stat-number">25+</span>
          <span class="stat-label">{i.home.statYears}</span>
        </div>
        <div class="stat">
          <span class="stat-number">4</span>
          <span class="stat-label">{i.home.statPlatforms}</span>
        </div>
        <div class="stat">
          <span class="stat-number">4</span>
          <span class="stat-label">{i.home.statProducts}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech → value -->
  <section class="section" style="padding-top: 4rem; padding-bottom: 3rem;">
    <p class="section-label">{i.home.techLabel}</p>
    <h2 class="section-title">{i.home.techTitle}</h2>
    <p class="section-desc">{i.home.techDesc}</p>

    <div class="grid-3" style="margin-top: 2.5rem;">
      <div class="card">
        <h3 class="card-title">{i.home.techSpeedTitle}</h3>
        <p class="card-desc">{i.home.techSpeedDesc}</p>
      </div>
      <div class="card">
        <h3 class="card-title">{i.home.techAiTitle}</h3>
        <p class="card-desc">{i.home.techAiDesc}</p>
      </div>
      <div class="card">
        <h3 class="card-title">{i.home.techMobileTitle}</h3>
        <p class="card-desc">{i.home.techMobileDesc}</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-title">{i.home.ctaTitle}</h2>
      <p class="cta-desc">{i.home.ctaDesc}</p>
      <a href={localePath(lang, '/contact')} class="btn btn-primary">{i.home.ctaBtn}</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 10rem;
    padding-bottom: 5rem;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 0%, var(--color-accent-glow) 0%, transparent 60%),
      var(--color-bg);
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .hero-title-link {
    text-decoration: none;
    color: inherit;
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--color-accent), #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid-4 {
      grid-template-columns: 1fr;
    }
  }

  .card-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .card-for {
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .card-value {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .card-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    vertical-align: middle;
  }

  .stats-section {
    padding: 4rem 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .image-section {
    padding: 3rem 1.5rem;
  }

  .image-container {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }

  .section-image {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .cta-section {
    padding: 5rem 1.5rem;
  }

  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 3rem 2rem;
  }

  .cta-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
</style>
